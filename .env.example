# Copy to .env (never commit .env) and fill in real values
DB_URL=jdbc:postgresql://localhost:5432/parking_system_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reservations: hold time in minutes, and how often no-shows are expired (ms). Do not leave these empty.
RESERVATION_HOLD_MINUTES=30
RESERVATION_EXPIRY_CHECK_MS=60000
# Optional: seed an initial ADMIN account on startup (all three required)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
